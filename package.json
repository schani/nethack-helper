{
  "name": "nethack-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "build:nethack": "bash nethack/build.sh",
    "build": "npm run typecheck -w server && npm run build -w web",
    "start": "npm start -w server",
    "dev:web": "npm run dev -w web",
    "test": "npm test -w server && npm test -w web",
    "smoke": "npm run smoke -w server",
    "test:net": "npm run test:net -w server",
    "e2e:assistant": "node scripts/assistant-e2e/run.ts",
    "e2e:scenario": "node scripts/assistant-e2e/scenario.ts",
    "setup:nethack-src": "bash scripts/setup-nethack-src.sh"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
